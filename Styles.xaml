<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:AudioShare">

    <!-- Palette iOS (mode sombre). Charte des tuiles : design/README.md ;
         les mêmes couleurs sont reprises en code dans Palette (Tile.cs). -->
    <Color x:Key="AccentColor">#0A84FF</Color>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="Green" Color="#30D158"/>
    <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="OrangeText" Color="#FFB340"/>
    <SolidColorBrush x:Key="Red" Color="#FF6961"/>
    <SolidColorBrush x:Key="RedText" Color="#FF8A84"/>
    <SolidColorBrush x:Key="BlueLight" Color="#4DA3FF"/>
    <SolidColorBrush x:Key="BlueText" Color="#7DBBFF"/>
    <SolidColorBrush x:Key="Label" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LabelSecondary" Color="#99EBEBF5"/>
    <SolidColorBrush x:Key="LabelValue" Color="#B3EBEBF5"/>
    <SolidColorBrush x:Key="LabelTertiary" Color="#4DEBEBF5"/>
    <SolidColorBrush x:Key="CardFill" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardStroke" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Separator" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="TrackOff" Color="#3D787880"/>
    <SolidColorBrush x:Key="SegmentBed" Color="#3D787880"/>
    <SolidColorBrush x:Key="SegmentActive" Color="#8C8E8E93"/>

    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Carte translucide : le verre par-dessus l'acrylique du système.
         Même rayon que les tuiles (18). -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="16,4"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LabelSecondary}"/>
        <Setter Property="Margin" Value="6,14,6,6"/>
    </Style>

    <!-- Libellé d'une ligne dans une carte (AirPods, Avancé) -->
    <Style x:Key="CardRowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource Label}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Ligne de réglage dans une carte (AirPods, Avancé) : s'éclaire seule
         au survol, pour qu'on voie qu'on touche CETTE option et pas la carte
         entière. La surbrillance déborde de 8 px du texte : le conteneur
         doit laisser cette place (pas de rognage au ras des lignes). -->
    <Style x:Key="SettingRow" TargetType="ContentControl">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Background="#00FFFFFF">
                        <Border x:Name="Hover" CornerRadius="9" Margin="-8,3" Background="#14FFFFFF" Opacity="0"/>
                        <ContentPresenter/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.28"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton rond de l'en-tête (engrenage) : le fond est animé en code
         (allumé dans les Réglages), d'où le TemplateBinding. -->
    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource Label}"/>
        <Setter Property="Background" Value="#3D787880"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="16" Background="{TemplateBinding Background}"/>
                        <Border x:Name="Hover" CornerRadius="16" Background="#1FFFFFFF" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="0.86" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="0.86" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Petit bouton rond sombre (aperçu ▶ de la carte AirPods) : même
         famille que le ✕ des tuiles. -->
    <Style x:Key="RoundIconButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="#40000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border CornerRadius="13" Background="{TemplateBinding Background}"/>
                        <Border x:Name="Hover" CornerRadius="13" Background="#26FFFFFF" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1.1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1.1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="0.88" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="0.88" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton muet posé DANS la barre de volume : pas de fond, la couleur
         du pictogramme est choisie en code (sombre sur la partie remplie,
         blanc sur la piste). -->
    <Style x:Key="BarIconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="0.8" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="0.8" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.8"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.8"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barre de volume épaisse (maquette : 44 de haut, rayon 14). Le
         remplissage est piloté par VolumeBar (code) : animé, et rogné aux
         coins arrondis par le clip posé sur le contrôle. -->
    <Style x:Key="VolumeBarStyle" TargetType="{x:Type local:VolumeBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VolumeBar}">
                    <Grid Background="#4D787880">
                        <Border x:Name="Fill" Background="#EBFFFFFF" RenderTransformOrigin="0,0.5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bascule sans interrupteur (décision de Selim) : « ● Activé » en
         vert / « ● Désactivé » en gris, fondu croisé entre les deux. Le
         texte allumé est Content, le texte éteint Tag (posés en code). Un
         toucher sur toute la ligne bascule (MainWindow.ToggleRow_Click). -->
    <Style x:Key="DotToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="#00FFFFFF">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Glow" Width="16" Height="16" Margin="-5" Opacity="0">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#9930D158" Offset="0"/>
                                            <GradientStop Color="#0030D158" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Fill="#66EBEBF5"/>
                                <Ellipse x:Name="DotOn" Fill="#30D158" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="DotPop" ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="OffText" Text="{TemplateBinding Tag}"
                                           FontFamily="{StaticResource Body}" FontSize="12.5"
                                           Foreground="{StaticResource LabelSecondary}"/>
                                <TextBlock x:Name="OnText" Text="{TemplateBinding Content}" Opacity="0"
                                           FontFamily="{StaticResource Body}" FontSize="12.5"
                                           Foreground="{StaticResource Green}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotOn" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="OnText" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="OffText" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="DotPop" Storyboard.TargetProperty="ScaleX"
                                                         From="0.3" To="1" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="1.2"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="DotPop" Storyboard.TargetProperty="ScaleY"
                                                         From="0.3" To="1" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="1.2"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotOn" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="OnText" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="OffText" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.22"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ligne dépliable (« Avancé ») : contenu à gauche, chevron ⌄ qui se
         retourne quand Tag="open" (posé en code). -->
    <Style x:Key="ExpandRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Hover" CornerRadius="17" Background="#0FFFFFFF" Opacity="0"/>
                        <Grid Margin="16,0">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,22,0"/>
                            <TextBlock Text="&#xE70D;" FontSize="11"
                                       FontFamily="{StaticResource Icons}"
                                       Foreground="{StaticResource LabelTertiary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="Turn" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="open">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle"
                                                         To="180" Duration="0:0:0.34">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle"
                                                         To="0" Duration="0:0:0.34">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Sélecteur segmenté iOS -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Pas de pastille ici : une seule pastille par sélecteur,
                         posée en code (MainWindow.AttachSlidingPill), glisse
                         d'un segment à l'autre. Le fond transparent garde
                         tout le segment cliquable. -->
                    <Grid Margin="2" Background="#00FFFFFF">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource Body}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="Medium" Foreground="{StaticResource Label}"
                                   Opacity="0.6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Text"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Text"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.6" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Curseur iOS : rail fin, pastille ronde -->
    <Style x:Key="IosSlider" TargetType="Slider">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Focusable="False" Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="White"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Focusable="False" Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{StaticResource TrackOff}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="Grow" ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                                      Direction="270" Opacity="0.3"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <!-- La pastille grossit sous le pointeur et le
                                                 reste pendant le glisser (souris capturée) -->
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Grow"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1.22" Duration="0:0:0.12"/>
                                                                <DoubleAnimation Storyboard.TargetName="Grow"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1.22" Duration="0:0:0.12"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Grow"
                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                 To="1" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetName="Grow"
                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                 To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ligne de navigation (Réglages → sous-page) : libellé + chevron,
         survol en fondu, pression en léger retrait -->
    <Style x:Key="NavRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="{StaticResource Label}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Hover" CornerRadius="9"
                                Background="#12FFFFFF" Opacity="0"/>
                        <Grid Margin="10,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE76C;" FontSize="12"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource LabelTertiary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="Turn" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Ligne dépliable : Tag="open" (posé en code) fait
                             pivoter le chevron vers le bas -->
                        <Trigger Property="Tag" Value="open">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Turn"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="90" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Turn"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.98" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Press"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.98" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Press"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Press"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barre de défilement : un simple trait, sans flèches -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinWidth" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="2" Background="#66FFFFFF"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zone défilante du flyout : la barre flotte par-dessus le contenu
         (elle ne lui prend aucune largeur) et n'apparaît, en fondu, que
         sous le pointeur et s'il y a de quoi défiler -->
    <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <!-- Tactile : défilement au doigt (désactivé par défaut en WPF) -->
        <Setter Property="PanningMode" Value="VerticalOnly"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <!-- Fond transparent : la molette agit aussi entre les cartes -->
                    <Grid Background="#00FFFFFF">
                        <ScrollContentPresenter/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource ThinScrollBar}"
                                   HorizontalAlignment="Right" Margin="0,4,7,14" Opacity="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liste déroulante minimale -->
    <Style x:Key="PlainCombo" TargetType="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource LabelSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="#00FFFFFF">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ContentPresenter Content="{Binding SelectionBoxItem,
                                                              RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                              RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              TextElement.Foreground="{Binding Foreground,
                                                              RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="⌄" FontSize="13" Margin="0,-4,0,0"
                                                       Foreground="{StaticResource LabelTertiary}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                            <Border Background="#F0201F27" CornerRadius="12" Padding="5"
                                    BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                                    MaxHeight="240" Margin="0,6,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3"
                                                      Direction="270" Opacity="0.5"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Grid Background="#00FFFFFF">
                                    <Border x:Name="Sel" CornerRadius="8" Background="#2E0A84FF" Opacity="0"/>
                                    <Border x:Name="Hover" CornerRadius="8" Background="#1FFFFFFF" Opacity="0"/>
                                    <Border Padding="11,8">
                                        <ContentPresenter/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Sel" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
