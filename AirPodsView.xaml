<UserControl x:Class="AudioShare.AirPodsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioShare">

    <!-- Bloc AirPods partagé par la popup et la carte de la page principale :
         vignette du boîtier à gauche ; à droite le nom et le bouton d'action,
         puis les batteries (ou un état : progression, succès, erreur…). -->
    <UserControl.Resources>
        <Style x:Key="BatteryText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Label}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Vignette : le boîtier (dessiné et animé en code) -->
        <Border Style="{StaticResource Card}" Padding="0" CornerRadius="12"
                Width="56" Height="56" VerticalAlignment="Center">
            <Viewbox Stretch="Uniform" Margin="7">
                <Canvas x:Name="Scene" Width="150" Height="108"/>
            </Viewbox>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText" Text="AirPods"
                       FontFamily="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource Label}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

            <!-- Action : même bouton que « Vérifier » / « Afficher » des Réglages -->
            <Button x:Name="ActionButton" Grid.Column="1" Content="Connect"
                    Style="{StaticResource TintedButton}" Focusable="False"
                    MinWidth="94" Height="30" FontSize="12.5" Padding="14,0" Margin="10,0,0,0"
                    VerticalAlignment="Center" Click="Action_Click"/>

            <!-- Batteries : mini-anneaux gauche, droit, boîtier -->
            <StackPanel x:Name="BatteryRow" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                    <local:RingGauge x:Name="LeftRing" Width="14" Height="14" Thickness="2.3"
                                     Track="{StaticResource TrackOff}"/>
                    <TextBlock x:Name="LeftText" Style="{StaticResource BatteryText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,9,0">
                    <local:RingGauge x:Name="RightRing" Width="14" Height="14" Thickness="2.3"
                                     Track="{StaticResource TrackOff}"/>
                    <TextBlock x:Name="RightText" Style="{StaticResource BatteryText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <local:RingGauge x:Name="CaseRing" Width="14" Height="14" Thickness="2.3"
                                     Track="{StaticResource TrackOff}"/>
                    <TextBlock x:Name="CaseText" Style="{StaticResource BatteryText}"/>
                </StackPanel>
            </StackPanel>

            <!-- État : progression, succès, erreur, info (ou texte seul) -->
            <StackPanel x:Name="StatusPanel" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        Margin="0,6,0,0" Visibility="Collapsed">
                <Grid x:Name="StatusIcon" Width="15" Height="15" Margin="0,1,7,0" VerticalAlignment="Top">
                    <Path x:Name="Spinner" Data="M 7.5,1.2 A 6.3,6.3 0 1 1 1.2,7.5"
                          Stroke="{StaticResource Accent}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Path.RenderTransform>
                    </Path>
                    <Border x:Name="StatusBadge" CornerRadius="7.5" Background="{StaticResource Green}">
                        <TextBlock x:Name="StatusGlyph" Text="&#xE73E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="8" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusText" MaxWidth="230" TextWrapping="Wrap"
                           FontFamily="{StaticResource Body}" FontSize="12.5"
                           Foreground="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
