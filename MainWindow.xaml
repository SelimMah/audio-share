<Window x:Class="AudioShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Duckast"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                            ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </Grid.Resources>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide"/>
        </Grid.RenderTransform>
            <StackPanel Margin="20,18,20,20">

                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <!-- Logo : présent sur la page principale seulement, il se
                             replie (largeur animée en code) quand on entre dans les
                             Réglages et le titre glisse à sa place. Les tracés
                             viennent de DuckLogo, posés en code. -->
                        <Border x:Name="LogoHost" Width="44" Background="#00FFFFFF" ClipToBounds="True"
                                VerticalAlignment="Center">
                            <Viewbox x:Name="LogoBox" RenderTransformOrigin="0.5,0.5" Width="30" Height="30" Margin="4,3" HorizontalAlignment="Left">
                                <Canvas Width="512" Height="512">
                                    <Path x:Name="LogoBeak" Fill="#FF7A10"/>
                                    <Path x:Name="LogoWing" Fill="#188C46"
                                          Stroke="#188C46" StrokeThickness="6"/>
                                    <Path x:Name="LogoBody" Fill="{StaticResource Label}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Duckast"
                                   FontFamily="{StaticResource Display}"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource Label}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TitleSlide"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="SettingsButton" Content="&#xE713;" Width="32" Height="32"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                            Style="{StaticResource ChromeButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Click="Settings_Click" ToolTip="Réglages">
                        <Button.RenderTransform>
                            <RotateTransform x:Name="SettingsSpin"/>
                        </Button.RenderTransform>
                    </Button>
                </Grid>

                <!-- Zone défilante : hors de la page principale sa hauteur est
                     figée (en code) sur celle de la page principale — le
                     panneau ne change jamais de taille, ce qui dépasse défile.
                     Marges négatives : elle va jusqu'aux bords de la fenêtre,
                     pour que les pages qui glissent ne soient pas rognées
                     au ras des cartes. -->
                <ScrollViewer x:Name="PageScroll" Style="{StaticResource OverlayScroll}"
                              Margin="-20,0,-20,-20">
                <!-- Les pages partagent la même cellule : pendant une transition,
                     celle qui part et celle qui arrive se superposent en fondu. -->
                <Grid x:Name="PageHost" Margin="20,0,20,20">

                <!-- Page Réglages : remplace la page principale -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="GeneralHeader" Text="GENERAL" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}" Padding="16,4">
                        <StackPanel>
                            <Grid Height="44" Background="Transparent" MouseLeftButtonUp="ToggleRow_Click">
                                <TextBlock x:Name="AutostartLabel" Text="Launch at Windows startup"
                                           Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="AutostartToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}"/>
                            <Grid Height="44" Background="Transparent" MouseLeftButtonUp="ToggleRow_Click">
                                <TextBlock x:Name="DarkModeLabel" Text="Dark mode"
                                           Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="DarkModeToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="DarkMode_Changed" Unchecked="DarkMode_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}"/>
                            <Grid Height="44">
                                <TextBlock x:Name="LanguageLabel" Text="Language"
                                           Style="{StaticResource RowLabel}"/>
                                <Border CornerRadius="9" Background="{StaticResource SegmentBed}"
                                        Width="170" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid x:Name="LangSegments">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="LangEnglish" Grid.Column="0" Content="English"
                                                     GroupName="Lang" Style="{StaticResource Segment}"
                                                     Checked="Language_Checked"/>
                                        <RadioButton x:Name="LangFrench" Grid.Column="1" Content="Français"
                                                     GroupName="Lang" Style="{StaticResource Segment}"
                                                     Checked="Language_Checked"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}"/>
                            <Grid Height="44">
                                <TextBlock x:Name="UpdateLabel" Text="Updates" Style="{StaticResource RowLabel}"/>
                                <Button x:Name="CheckUpdateButton" Content="Check"
                                        Width="94" Height="30" FontSize="12.5"
                                        Style="{StaticResource TintedButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="CheckUpdate_Click"/>
                            </Grid>
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap"
                                       FontFamily="{StaticResource Body}" FontSize="12"
                                       Foreground="{StaticResource LabelTertiary}" LineHeight="16"
                                       Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>

                    <!-- Avancé : les réglages qu'on ne touche presque jamais
                         (sortie, destination, compression) et l'accès au
                         diagnostic. La ligne déplie son contenu sur place
                         (hauteur de AdvancedHost animée en code). -->
                    <Border Style="{StaticResource Card}" Padding="6,4" Margin="0,14,0,0">
                        <StackPanel>
                        <Button x:Name="AdvancedNavButton" Style="{StaticResource NavRow}"
                                Click="AdvancedNav_Click">
                            <TextBlock x:Name="AdvancedNavLabel" Text="Advanced"
                                       FontFamily="{StaticResource Body}" FontSize="14"
                                       Foreground="{StaticResource Label}"/>
                        </Button>
                        <Border x:Name="AdvancedHost" Height="0" Opacity="0"
                                ClipToBounds="True" IsHitTestVisible="False">
                        <StackPanel x:Name="AdvancedContent" VerticalAlignment="Top">
                        <Border Height="1" Background="{StaticResource Separator}" Margin="10,0"/>
                        <Grid x:Name="OutputRow" Height="44" Margin="10,0">
                            <TextBlock x:Name="OutputLabel" Text="Received audio output"
                                       Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="OutputCombo" Style="{StaticResource PlainCombo}"
                                      MaxWidth="180" DisplayMemberPath="Name"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      SelectionChanged="Output_Changed"/>
                        </Grid>
                            <Border Height="1" Background="{StaticResource Separator}" Margin="10,0"/>
                            <Grid x:Name="DestRow" Height="44" Margin="10,0">
                                <TextBlock x:Name="DestLabel" Text="Send to"
                                           Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="DestCombo" Style="{StaticResource PlainCombo}"
                                          MaxWidth="180" DisplayMemberPath="Name"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          SelectionChanged="Dest_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}" Margin="10,0"/>
                            <Grid x:Name="OpusRow" Height="44" Margin="10,0" Background="Transparent" MouseLeftButtonUp="ToggleRow_Click">
                                <TextBlock x:Name="OpusLabel" Text="Opus compression (Wi-Fi)"
                                           Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="OpusToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Opus_Changed" Unchecked="Opus_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}" Margin="10,0"/>
                        <Button x:Name="DiagNavButton" Style="{StaticResource NavRow}"
                                Click="DiagNav_Click">
                            <TextBlock x:Name="DiagNavLabel" Text="Diagnostics"
                                       FontFamily="{StaticResource Body}" FontSize="14"
                                       Foreground="{StaticResource Label}"/>
                        </Button>
                        </StackPanel>
                        </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page Diagnostic : accessible depuis les Réglages -->
                <StackPanel x:Name="DiagPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DiagStreamHeader" Text="STREAM" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}" Padding="16,4">
                        <StackPanel>
                            <Grid Height="40">
                                <TextBlock x:Name="DiagLatencyLabel" Text="Latency"
                                           Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="DiagLatency" Text="—"
                                           FontFamily="{StaticResource Body}" FontSize="13"
                                           Foreground="{StaticResource LabelSecondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}"/>
                            <Grid Height="40">
                                <TextBlock x:Name="DiagRateLabel" Text="Bitrate"
                                           Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="DiagRate" Text="—"
                                           FontFamily="{StaticResource Body}" FontSize="13"
                                           Foreground="{StaticResource LabelSecondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="DiagLogHeader" Text="LOG" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}" Padding="16,10">
                        <TextBlock x:Name="DiagLog" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="{StaticResource LabelTertiary}" LineHeight="14"/>
                    </Border>
                </StackPanel>

                <!-- Page principale -->
                <StackPanel x:Name="MainPanel">

                <!-- Sources : téléphones Bluetooth et réseau local, une seule carte -->
                <TextBlock Text="SOURCES" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <ListBox x:Name="DeviceList" Style="{StaticResource PlainList}"
                                 MaxHeight="150" SelectionChanged="DeviceList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="13" Height="20" CornerRadius="3"
                                                BorderThickness="1.4" Margin="0,0,0,0"
                                                HorizontalAlignment="Left"
                                                BorderBrush="{StaticResource LabelSecondary}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontFamily="{StaticResource Body}" FontSize="14"
                                                   Foreground="{StaticResource Label}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                   FontFamily="{StaticResource Body}" FontSize="12"
                                                   Foreground="{StaticResource Green}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="✕" Width="26" Height="26"
                                                Margin="10,0,0,0" FontSize="12"
                                                Style="{StaticResource ChromeButton}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                Click="Disconnect_Click" ToolTip="Arrêter la réception"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyHint" Margin="10,9,10,9" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Body}" FontSize="12.5"
                                   Foreground="{StaticResource LabelSecondary}"
                                   Visibility="Collapsed"
                                   Text="No paired phone — pair one in Windows Bluetooth settings."/>

                        <Border Height="1" Background="{StaticResource Separator}" Margin="10,2"/>

                        <!-- Réception réseau : toujours active, état à droite -->
                        <Grid x:Name="NetworkRow" Margin="10,8"
                              ToolTip="Another PC running Duckast can stream its audio here: turn on “Send” over there, the connection is automatic.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE701;" FontSize="15"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource LabelSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="NetworkLabel" Text="Local network"
                                       FontFamily="{StaticResource Body}" FontSize="14"
                                       Foreground="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="NetworkStatus"
                                       FontFamily="{StaticResource Body}" FontSize="12"
                                       Foreground="{StaticResource LabelTertiary}"
                                       VerticalAlignment="Center" Text="listening"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Separator}" Margin="10,2"/>

                        <!-- Émission vers un autre PC -->
                        <Grid Margin="10,5" Height="34" Background="Transparent" MouseLeftButtonUp="ToggleRow_Click">
                            <TextBlock x:Name="SendLabel" Text="Send this PC's audio" Style="{StaticResource RowLabel}"/>
                            <CheckBox x:Name="SendToggle" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="SendToggle_Changed" Unchecked="SendToggle_Changed"/>
                        </Grid>

                        <TextBlock x:Name="SendStatus" TextWrapping="Wrap" Visibility="Collapsed"
                                   FontFamily="{StaticResource Body}" FontSize="12"
                                   Foreground="{StaticResource LabelTertiary}" LineHeight="16"
                                   Margin="10,0,10,8"/>
                    </StackPanel>
                </Border>

                <!-- Volume et balance du son reçu (Bluetooth ou réseau) ; la
                     section devient « SENT AUDIO » pendant l'émission et le
                     curseur pilote alors le volume émis. -->
                <TextBlock x:Name="VolumeHeader" Text="RECEIVED AUDIO" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                    <Grid>
                        <!-- Vumètre : aurore diffuse sur tout le fond de la carte —
                             des nappes de couleur floutées qui respirent (opacité)
                             et dérivent en 2D avec le niveau du son. Invisible au
                             repos ; le clip arrondi (posé en code) suit la carte. -->
                        <Border x:Name="VuClip">
                            <!-- Canvas : taille nulle en layout, les nappes peuvent
                                 déborder sans agrandir la carte — le clip coupe.
                                 Les nappes elles-mêmes sont générées en code
                                 (formes, vitesses et couleurs aléatoires). -->
                            <!-- Pas de BlurEffect : un Effect WPF casse la
                                 composition de l'acrylique DWM (et coûte cher).
                                 La diffusion vient des dégradés radiaux
                                 eux-mêmes, qui fondent en transparence. -->
                            <Canvas x:Name="VuGlow" IsHitTestVisible="False" Opacity="0"/>
                        </Border>
                        <Grid Margin="12,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MuteButton" Grid.Column="0" Content="&#xE995;"
                                    Width="32" Height="32" FontSize="15"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Style="{StaticResource ChromeButton}"
                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                    Click="Mute_Click"/>
                            <Slider x:Name="VolumeSlider" Grid.Column="1"
                                    Style="{StaticResource IosSlider}"
                                    IsMoveToPointEnabled="True"
                                    ValueChanged="Volume_Changed"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="BalanceCard" CornerRadius="9" Background="{StaticResource SegmentBed}" Height="34"
                        Margin="0,0,0,2"
                        ToolTip="Only affects the received audio (phone or other PC) — never this PC's own sounds.">
                    <Grid x:Name="BalanceSegments">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="BalanceLeft" Grid.Column="0" Content="Left"
                                     GroupName="Bal" Style="{StaticResource Segment}"
                                     Checked="Balance_Checked"/>
                        <RadioButton x:Name="BalanceStereo" Grid.Column="1" Content="Stereo"
                                     GroupName="Bal" Style="{StaticResource Segment}" IsChecked="True"
                                     Checked="Balance_Checked"/>
                        <RadioButton x:Name="BalanceRight" Grid.Column="2" Content="Right"
                                     GroupName="Bal" Style="{StaticResource Segment}"
                                     Checked="Balance_Checked"/>
                    </Grid>
                </Border>

                </StackPanel>
                </Grid>
                </ScrollViewer>
            </StackPanel>
    </Grid>
</Window>
