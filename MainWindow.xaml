<Window x:Class="AudioShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Audio Share"
        Width="400" Height="712"
        WindowStyle="None" AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                            ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </Grid.Resources>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide"/>
        </Grid.RenderTransform>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,24">
            <StackPanel Margin="20,0,20,0">

                <TextBlock Text="Audio Share" FontFamily="{StaticResource Display}"
                           FontSize="30" FontWeight="Bold" Foreground="{StaticResource Label}"
                           Margin="4,0,0,2"/>
                <TextBlock Text="Ton PC devient une enceinte Bluetooth"
                           FontFamily="{StaticResource Body}" FontSize="13"
                           Foreground="{StaticResource LabelSecondary}" Margin="4,0,0,0"
                           TextWrapping="Wrap"/>

                <!-- Appareils -->
                <TextBlock Text="APPAREILS APPAIRÉS" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <ListBox x:Name="DeviceList" Style="{StaticResource PlainList}"
                                 MaxHeight="150" SelectionChanged="DeviceList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="13" Height="20" CornerRadius="3"
                                                BorderThickness="1.4" Margin="2,0,12,0"
                                                BorderBrush="{StaticResource LabelSecondary}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontFamily="{StaticResource Body}" FontSize="14"
                                                   Foreground="{StaticResource Label}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                   FontFamily="{StaticResource Body}" FontSize="12"
                                                   Foreground="{StaticResource Green}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="✕" Width="26" Height="26"
                                                Margin="10,0,0,0" FontSize="12"
                                                Style="{StaticResource ChromeButton}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                Click="Disconnect_Click" ToolTip="Arrêter la réception"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyHint" Margin="10,10,10,12" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Body}" FontSize="12.5"
                                   Foreground="{StaticResource LabelSecondary}"
                                   Visibility="Collapsed"
                                   Text="Aucun appareil. Appaire ton téléphone via le lien ci-dessous, il apparaîtra ici."/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center">
                    <Hyperlink Click="OpenSettings_Click" TextDecorations="None"
                               Foreground="{StaticResource Accent}">
                        <Run Text="Ouvrir l'appairage Bluetooth" FontFamily="Segoe UI Variable Text"
                             FontSize="12.5"/>
                    </Hyperlink>
                </TextBlock>

                <!-- Réseau local : réception (toujours active) et émission -->
                <TextBlock Text="RÉSEAU" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="NetworkStatus" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Body}" FontSize="12.5"
                                   Foreground="{StaticResource LabelSecondary}" LineHeight="17"
                                   Text="En écoute — installe Audio Share sur l'autre PC et active « Envoyer » là-bas."/>

                        <Border Height="1" Background="{StaticResource Separator}" Margin="0,11,0,0"/>

                        <Grid Height="44">
                            <TextBlock Text="Envoyer le son de ce PC" Style="{StaticResource RowLabel}"/>
                            <CheckBox x:Name="SendToggle" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="SendToggle_Changed" Unchecked="SendToggle_Changed"/>
                        </Grid>

                        <TextBlock x:Name="SendStatus" TextWrapping="Wrap" Visibility="Collapsed"
                                   FontFamily="{StaticResource Body}" FontSize="12"
                                   Foreground="{StaticResource LabelTertiary}" LineHeight="16"
                                   Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Volume et balance du son reçu (Bluetooth ou réseau) -->
                <TextBlock Text="SON REÇU" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE993;" FontSize="12"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{StaticResource LabelTertiary}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1"
                                Style="{StaticResource IosSlider}"
                                ValueChanged="Volume_Changed"/>
                        <TextBlock Grid.Column="2" Text="&#xE995;" FontSize="12"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{StaticResource LabelTertiary}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>
                <Border CornerRadius="9" Background="{StaticResource SegmentBed}" Height="34">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="BalanceLeft" Grid.Column="0" Content="Gauche"
                                     GroupName="Bal" Style="{StaticResource Segment}"
                                     Checked="Balance_Checked"/>
                        <RadioButton x:Name="BalanceStereo" Grid.Column="1" Content="Stéréo"
                                     GroupName="Bal" Style="{StaticResource Segment}" IsChecked="True"
                                     Checked="Balance_Checked"/>
                        <RadioButton x:Name="BalanceRight" Grid.Column="2" Content="Droite"
                                     GroupName="Bal" Style="{StaticResource Segment}"
                                     Checked="Balance_Checked"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="BalanceNote" Margin="4,10,4,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource Body}" FontSize="12"
                           Foreground="{StaticResource LabelTertiary}" LineHeight="17"
                           Text="Le volume et la balance n'agissent que sur le son reçu (téléphone ou autre PC) — jamais sur les sons de ce PC."/>

                <TextBlock x:Name="StatusText" Margin="4,18,4,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource Body}" FontSize="12.5"
                           Foreground="{StaticResource LabelSecondary}" LineHeight="18"
                           Text="Clique sur ton téléphone dans la liste pour activer la réception."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
