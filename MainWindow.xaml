<Window x:Class="AudioShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Audio Share"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                            ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </Grid.Resources>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide"/>
        </Grid.RenderTransform>
            <StackPanel Margin="20,18,20,20">

                <Grid>
                    <TextBlock Text="Audio Share" FontFamily="{StaticResource Display}"
                               FontSize="26" FontWeight="Bold" Foreground="{StaticResource Label}"
                               Margin="4,0,0,0"/>
                    <Button x:Name="SettingsButton" Content="&#xE713;" Width="32" Height="32"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                            Style="{StaticResource ChromeButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Settings_Click" ToolTip="Réglages"/>
                </Grid>

                <!-- Réglages, dépliés par l'engrenage -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="RÉGLAGES" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}" Padding="16,4">
                        <StackPanel>
                            <Grid Height="44">
                                <TextBlock Text="Ouvrir au démarrage de Windows"
                                           Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="AutostartToggle" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}"/>
                            <Grid Height="44">
                                <TextBlock Text="Mise à jour" Style="{StaticResource RowLabel}"/>
                                <Button x:Name="CheckUpdateButton" Content="Vérifier"
                                        Width="94" Height="30" FontSize="12.5"
                                        Style="{StaticResource TintedButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="CheckUpdate_Click"/>
                            </Grid>
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap"
                                       FontFamily="{StaticResource Body}" FontSize="12"
                                       Foreground="{StaticResource LabelTertiary}" LineHeight="16"
                                       Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sources : téléphones Bluetooth et réseau local, une seule carte -->
                <TextBlock Text="SOURCES" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Padding="6">
                    <StackPanel>
                        <ListBox x:Name="DeviceList" Style="{StaticResource PlainList}"
                                 MaxHeight="150" SelectionChanged="DeviceList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="13" Height="20" CornerRadius="3"
                                                BorderThickness="1.4" Margin="0,0,0,0"
                                                HorizontalAlignment="Left"
                                                BorderBrush="{StaticResource LabelSecondary}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontFamily="{StaticResource Body}" FontSize="14"
                                                   Foreground="{StaticResource Label}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                   FontFamily="{StaticResource Body}" FontSize="12"
                                                   Foreground="{StaticResource Green}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="✕" Width="26" Height="26"
                                                Margin="10,0,0,0" FontSize="12"
                                                Style="{StaticResource ChromeButton}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                Click="Disconnect_Click" ToolTip="Arrêter la réception"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyHint" Margin="10,9,10,9" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Body}" FontSize="12.5"
                                   Foreground="{StaticResource LabelSecondary}"
                                   Visibility="Collapsed"
                                   Text="Aucun téléphone appairé — utilise le lien ci-dessous."/>

                        <Border Height="1" Background="{StaticResource Separator}" Margin="10,2"/>

                        <!-- Réception réseau : toujours active, état à droite -->
                        <Grid Margin="10,8"
                              ToolTip="Un autre PC avec Audio Share peut diffuser son audio ici : active « Envoyer » là-bas, la connexion est automatique.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE701;" FontSize="15"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource LabelSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Réseau local"
                                       FontFamily="{StaticResource Body}" FontSize="14"
                                       Foreground="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="NetworkStatus"
                                       FontFamily="{StaticResource Body}" FontSize="12"
                                       Foreground="{StaticResource LabelTertiary}"
                                       VerticalAlignment="Center" Text="en écoute"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Separator}" Margin="10,2"/>

                        <!-- Émission vers un autre PC -->
                        <Grid Margin="10,5" Height="34">
                            <TextBlock Text="Envoyer le son de ce PC" Style="{StaticResource RowLabel}"/>
                            <CheckBox x:Name="SendToggle" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="SendToggle_Changed" Unchecked="SendToggle_Changed"/>
                        </Grid>

                        <TextBlock x:Name="SendStatus" TextWrapping="Wrap" Visibility="Collapsed"
                                   FontFamily="{StaticResource Body}" FontSize="12"
                                   Foreground="{StaticResource LabelTertiary}" LineHeight="16"
                                   Margin="10,0,10,8"/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center">
                    <Hyperlink Click="OpenSettings_Click" TextDecorations="None"
                               Foreground="{StaticResource Accent}">
                        <Run Text="Ouvrir l'appairage Bluetooth" FontFamily="Segoe UI Variable Text"
                             FontSize="12.5"/>
                    </Hyperlink>
                </TextBlock>

                <!-- Volume et balance du son reçu (Bluetooth ou réseau) -->
                <TextBlock Text="SON REÇU" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE993;" FontSize="12"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{StaticResource LabelTertiary}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1"
                                Style="{StaticResource IosSlider}"
                                ValueChanged="Volume_Changed"/>
                        <TextBlock Grid.Column="2" Text="&#xE995;" FontSize="12"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{StaticResource LabelTertiary}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Border>
                <Border CornerRadius="9" Background="{StaticResource SegmentBed}" Height="34"
                        ToolTip="N'agit que sur le son reçu (téléphone ou autre PC) — jamais sur les sons de ce PC.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="BalanceLeft" Grid.Column="0" Content="Gauche"
                                     GroupName="Bal" Style="{StaticResource Segment}"
                                     Checked="Balance_Checked"/>
                        <RadioButton x:Name="BalanceStereo" Grid.Column="1" Content="Stéréo"
                                     GroupName="Bal" Style="{StaticResource Segment}" IsChecked="True"
                                     Checked="Balance_Checked"/>
                        <RadioButton x:Name="BalanceRight" Grid.Column="2" Content="Droite"
                                     GroupName="Bal" Style="{StaticResource Segment}"
                                     Checked="Balance_Checked"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText" Margin="4,12,4,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource Body}" FontSize="12"
                           Foreground="{StaticResource LabelTertiary}" LineHeight="16"
                           Text="Clique sur un appareil pour activer la réception."/>
            </StackPanel>
    </Grid>
</Window>
