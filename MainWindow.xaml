<Window x:Class="AudioShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AudioShare"
        Title="Duckast"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="True">

    <!-- Charte : design/README.md et design/maquettes/*.html (360 de large,
         marges 14, tuiles 161 × 112, rayon 18). -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                            ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide"/>
        </Grid.RenderTransform>
            <StackPanel Margin="14,14,14,16">

                <!-- En-tête : logo + titre de la page, engrenage (allumé dans les Réglages) -->
                <Grid Height="40" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <!-- Logo : tracés de DuckLogo posés en code ; il se dandine au survol. -->
                        <Border x:Name="LogoHost" Background="#00FFFFFF" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Viewbox x:Name="LogoBox" RenderTransformOrigin="0.5,0.5" Width="26" Height="26">
                                <Canvas Width="512" Height="512">
                                    <Path x:Name="LogoBeak" Fill="#FF7A10"/>
                                    <Path x:Name="LogoWing" Fill="#188C46"
                                          Stroke="#188C46" StrokeThickness="6"/>
                                    <Path x:Name="LogoBody" Fill="{StaticResource Label}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="TitleText" Text="Duckast" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Display}"
                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Label}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TitleSlide"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="SettingsButton" Content="&#xE713;"
                            Style="{StaticResource HeaderButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            Click="Settings_Click" ToolTip="Réglages">
                        <Button.RenderTransform>
                            <RotateTransform x:Name="SettingsSpin"/>
                        </Button.RenderTransform>
                    </Button>
                </Grid>

                <!-- Zone défilante : hors de la page principale sa hauteur est
                     figée (en code) sur celle de la page principale — toutes
                     les pages ont la taille de l'accueil, ce qui dépasse
                     défile. Marges négatives : elle va jusqu'aux bords de la
                     fenêtre, pour que les pages qui glissent ne soient pas
                     rognées au ras des tuiles. -->
                <ScrollViewer x:Name="PageScroll" Style="{StaticResource OverlayScroll}"
                              Margin="-14,0,-14,-16">
                <Grid x:Name="PageHost" Margin="14,0,14,16">

                <!-- ============================ Réglages ============================ -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="GeneralHeader" Text="GENERAL" Style="{StaticResource SectionHeader}"
                               Margin="6,2,6,6"/>

                    <!-- Tuiles 161 × 88 : touchées, elles s'allument comme celles de l'accueil -->
                    <Grid x:Name="GeneralTiles" Tag="cascade">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="88"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="88"/>
                        </Grid.RowDefinitions>
                        <local:Tile x:Name="AutostartTile" WrapTitle="True" Art="Power" Breathe="False" ContentPadding="14,12"/>
                        <local:Tile x:Name="DarkModeTile" WrapTitle="True" Grid.Column="2" Art="Moon" Breathe="False" ContentPadding="14,12"/>
                        <local:Tile x:Name="LanguageTile" Grid.Row="2" Art="Language"
                                    Breathe="False" ContentPadding="14,12"/>
                        <local:Tile x:Name="UpdateTile" WrapTitle="True" Grid.Row="2" Grid.Column="2" Art="Refresh"
                                    Breathe="False" ContentPadding="14,12"/>
                    </Grid>

                    <!-- AirPods : une carte qui s'allume comme une tuile ; toucher son
                         en-tête active / désactive la gestion. Les options se
                         déplient dessous quand elle est active. -->
                    <TextBlock x:Name="AirPodsSettingsHeader" Text="AIRPODS" Style="{StaticResource SectionHeader}"/>
                    <local:Tile x:Name="AirPodsSettingsTile" Art="CaseCorner" Breathe="False" FooterIsSeparate="True"
                                ContentPadding="14,14,14,2">
                        <local:Tile.Footer>
                            <!-- Élargi de 8 px de chaque côté : la place de la
                                 surbrillance des lignes (SettingRow), sinon rognée. -->
                            <Border x:Name="AirPodsOptionsHost" Height="0" Opacity="0" ClipToBounds="True"
                                    IsHitTestVisible="False" Margin="-8,0">
                                <StackPanel x:Name="AirPodsOptions" VerticalAlignment="Top" Margin="8,10,8,0">
                                    <Border Height="1" Background="{StaticResource Separator}"/>
                                    <ContentControl Style="{StaticResource SettingRow}"
                                                    MouseLeftButtonDown="SettingRow_Click">
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="AirPodsDeviceLabel" Text="Device"
                                                   Style="{StaticResource CardRowLabel}" Margin="0,0,12,0"/>
                                        <ComboBox x:Name="AirPodsDeviceCombo" Grid.Column="1"
                                                  Style="{StaticResource PlainCombo}" Foreground="{StaticResource LabelValue}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  SelectionChanged="AirPodsDevice_Changed"/>
                                    </Grid>
                                    </ContentControl>
                                    <Border Height="1" Background="{StaticResource Separator}"/>
                                    <ContentControl Style="{StaticResource SettingRow}"
                                                    MouseLeftButtonUp="SettingRow_Click">
                                    <Grid Height="40">
                                        <TextBlock x:Name="AirPodsPromptLabel" Text="Offer when the case opens"
                                                   Style="{StaticResource CardRowLabel}" Margin="0,0,90,0"/>
                                        <CheckBox x:Name="AirPodsPromptToggle" Style="{StaticResource DotToggle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="AirPodsPrompt_Changed" Unchecked="AirPodsPrompt_Changed"/>
                                    </Grid>
                                    </ContentControl>
                                    <Border Height="1" Background="{StaticResource Separator}"/>
                                    <ContentControl Style="{StaticResource SettingRow}"
                                                    MouseLeftButtonUp="SettingRow_Click">
                                    <Grid Height="40">
                                        <TextBlock x:Name="AirPodsPreviewLabel" Text="Window preview"
                                                   Style="{StaticResource CardRowLabel}"/>
                                        <Button x:Name="AirPodsPreviewButton" Style="{StaticResource RoundIconButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="AirPodsPreview_Click">
                                            <Path Data="M3 1.5 L10 6 L3 10.5 Z" Fill="White" Width="11" Height="11"
                                                  Stretch="None" Margin="1,0,0,0"/>
                                        </Button>
                                    </Grid>
                                    </ContentControl>
                                </StackPanel>
                            </Border>
                        </local:Tile.Footer>
                    </local:Tile>
                    <TextBlock x:Name="AirPodsHint" TextWrapping="Wrap"
                               FontFamily="{StaticResource Body}" FontSize="12"
                               Foreground="{StaticResource LabelTertiary}" LineHeight="16"
                               Margin="6,8,6,0"/>

                    <!-- Avancé : se déplie sur place (hauteur de AdvancedHost animée en code). -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                        <StackPanel>
                            <Button x:Name="AdvancedNavButton" Style="{StaticResource ExpandRow}"
                                    Click="AdvancedNav_Click">
                                <Grid>
                                    <TextBlock x:Name="AdvancedNavLabel" Text="Advanced"
                                               FontFamily="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Label}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AdvancedSummary" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="70,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource Body}" FontSize="12"
                                               Foreground="#80EBEBF5"/>
                                </Grid>
                            </Button>
                            <Border x:Name="AdvancedHost" Height="0" Opacity="0"
                                    ClipToBounds="True" IsHitTestVisible="False">
                                <StackPanel x:Name="AdvancedContent" VerticalAlignment="Top" Margin="16,0,16,4">
                                    <Border Height="1" Background="{StaticResource Separator}"/>
                                    <ContentControl Style="{StaticResource SettingRow}"
                                                    MouseLeftButtonDown="SettingRow_Click">
                                    <Grid x:Name="OutputRow" Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OutputLabel" Text="Output" Margin="0,0,12,0"
                                                   Style="{StaticResource CardRowLabel}"/>
                                        <ComboBox x:Name="OutputCombo" Grid.Column="1" Style="{StaticResource PlainCombo}"
                                                  Foreground="{StaticResource LabelValue}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  SelectionChanged="Output_Changed"/>
                                    </Grid>
                                    </ContentControl>
                                    <Border Height="1" Background="{StaticResource Separator}"/>
                                    <ContentControl Style="{StaticResource SettingRow}"
                                                    MouseLeftButtonDown="SettingRow_Click">
                                    <Grid x:Name="DestRow" Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DestLabel" Text="Send to" Margin="0,0,12,0"
                                                   Style="{StaticResource CardRowLabel}"/>
                                        <ComboBox x:Name="DestCombo" Grid.Column="1" Style="{StaticResource PlainCombo}"
                                                  Foreground="{StaticResource LabelValue}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  SelectionChanged="Dest_Changed"/>
                                    </Grid>
                                    </ContentControl>
                                    <Border Height="1" Background="{StaticResource Separator}"/>
                                    <ContentControl Style="{StaticResource SettingRow}"
                                                    MouseLeftButtonUp="SettingRow_Click">
                                    <Grid x:Name="OpusRow" Height="40">
                                        <TextBlock x:Name="OpusLabel" Text="Opus compression (Wi-Fi)"
                                                   Style="{StaticResource CardRowLabel}" Margin="0,0,90,0"/>
                                        <CheckBox x:Name="OpusToggle" Style="{StaticResource DotToggle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="Opus_Changed" Unchecked="Opus_Changed"/>
                                    </Grid>
                                    </ContentControl>
                                    <Border Height="1" Background="{StaticResource Separator}"/>
                                    <Button x:Name="DiagNavButton" Style="{StaticResource NavRow}" Height="40"
                                            Margin="-10,0" Click="DiagNav_Click">
                                        <TextBlock x:Name="DiagNavLabel" Text="Diagnostics"
                                                   FontFamily="{StaticResource Body}" FontSize="13.5"
                                                   Foreground="{StaticResource Label}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================ Diagnostic ============================ -->
                <StackPanel x:Name="DiagPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DiagStreamHeader" Text="STREAM" Style="{StaticResource SectionHeader}"
                               Margin="6,2,6,6"/>
                    <Border Style="{StaticResource Card}" Padding="16,2">
                        <StackPanel>
                            <Grid Height="40">
                                <TextBlock x:Name="DiagLatencyLabel" Text="Latency"
                                           Style="{StaticResource CardRowLabel}"/>
                                <TextBlock x:Name="DiagLatency" Text="—"
                                           FontFamily="{StaticResource Body}" FontSize="13"
                                           Foreground="{StaticResource LabelValue}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Separator}"/>
                            <Grid Height="40">
                                <TextBlock x:Name="DiagRateLabel" Text="Bitrate"
                                           Style="{StaticResource CardRowLabel}"/>
                                <TextBlock x:Name="DiagRate" Text="—"
                                           FontFamily="{StaticResource Body}" FontSize="13"
                                           Foreground="{StaticResource LabelValue}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="DiagLogHeader" Text="LOG" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <TextBlock x:Name="DiagLog" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="{StaticResource LabelSecondary}" LineHeight="14"/>
                    </Border>
                </StackPanel>

                <!-- ========================= Page principale ========================= -->
                <StackPanel x:Name="MainPanel">

                    <!-- Sources : 4 tuiles 2 × 2. Plus d'interrupteur : la tuile
                         s'allume quand elle est active ; un toucher la bascule. -->
                    <Grid x:Name="SourceTiles" Tag="cascade">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="112"/>
                        </Grid.RowDefinitions>
                        <local:Tile x:Name="PhoneTile" Art="Phone"/>
                        <local:Tile x:Name="NetworkTile" Grid.Column="2" Art="Globe"/>
                        <local:Tile x:Name="SendTile" Grid.Row="2" Art="Monitor"/>
                        <!-- Visible seulement quand la gestion AirPods est activée. -->
                        <local:Tile x:Name="AirPodsTile" Grid.Row="2" Grid.Column="2" Art="Case"
                                    Visibility="Collapsed"/>
                    </Grid>

                    <!-- Son reçu (« SON ÉMIS » pendant l'émission) : volume et
                         balance du son reçu uniquement, jamais des sons du PC. -->
                    <Grid x:Name="VolumeCard" Margin="0,10,0,2">
                        <Border Style="{StaticResource Card}"/>
                        <!-- Vumètre : aurore diffuse derrière la tuile, nappes générées
                             en code. Pas de BlurEffect (casse l'acrylique DWM) : la
                             diffusion vient des dégradés radiaux. Le clip arrondi est
                             posé en code. -->
                        <Border x:Name="VuClip" IsHitTestVisible="False">
                            <Canvas x:Name="VuGlow" Opacity="0"/>
                        </Border>
                        <Border CornerRadius="17" Margin="1" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0"
                                IsHitTestVisible="False"/>
                        <StackPanel Margin="16,14,16,14">
                            <Grid>
                                <TextBlock x:Name="VolumeHeader" Text="RECEIVED AUDIO"
                                           FontFamily="{StaticResource Body}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource LabelSecondary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VolumePercent" Text="—" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource Body}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Label}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Height="44" Margin="0,12,0,0">
                                <local:VolumeBar x:Name="VolumeSlider" Style="{StaticResource VolumeBarStyle}"
                                                 ValueChanged="Volume_Changed"/>
                                <Button x:Name="MuteButton" Content="&#xE995;" Style="{StaticResource BarIconButton}"
                                        Width="40" Height="40" Margin="3,0,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Click="Mute_Click">
                                    <Button.Foreground>
                                        <SolidColorBrush x:Name="MuteBrush" Color="#1B1D22"/>
                                    </Button.Foreground>
                                </Button>
                            </Grid>
                            <Border x:Name="BalanceCard" CornerRadius="9" Background="{StaticResource SegmentBed}"
                                    Height="34" Margin="0,12,0,0">
                                <Grid x:Name="BalanceSegments">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="BalanceLeft" Grid.Column="0" Content="Left"
                                                 GroupName="Bal" Style="{StaticResource Segment}"
                                                 Checked="Balance_Checked"/>
                                    <RadioButton x:Name="BalanceStereo" Grid.Column="1" Content="Stereo"
                                                 GroupName="Bal" Style="{StaticResource Segment}" IsChecked="True"
                                                 Checked="Balance_Checked"/>
                                    <RadioButton x:Name="BalanceRight" Grid.Column="2" Content="Right"
                                                 GroupName="Bal" Style="{StaticResource Segment}"
                                                 Checked="Balance_Checked"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                </StackPanel>
                </Grid>
                </ScrollViewer>
            </StackPanel>
    </Grid>
</Window>
