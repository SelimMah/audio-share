<Window x:Class="AudioShareSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Share — Émetteur"
        Width="440" Height="250" ResizeMode="CanMinimize"
        Background="#1e1e2e" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="26,22">
        <TextBlock Text="🔊 Audio Share — Émetteur"
                   FontSize="20" FontWeight="Bold" Foreground="White"/>
        <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap"
                   FontSize="14" Foreground="#f9e2af" Text="Démarrage…"/>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="17"
                   Foreground="#a6adc8"
                   Text="Ce programme capture tout le son de ce PC et l'envoie à Audio Share sur l'autre PC, par le réseau local. Il trouve le récepteur tout seul. Ferme cette fenêtre pour arrêter la diffusion."/>
    </StackPanel>
</Window>
