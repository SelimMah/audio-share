<Window x:Class="AudioShare.AirPodsPopup" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AudioShare"
        Title="Duckast" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <!-- Largeur : celle du panneau principal (400), alignée sur son bord droit. -->
    <!-- Notification AirPods au style du panneau Duckast : fond acrylique
         (permanent, voir WindowEffects.ApplyPopup), même bloc que la carte
         AirPods de la page principale (AirPodsView). Pas de croix : un clic à
         l'extérieur ou l'expiration ferment la popup. -->

    <!-- Vitre étendue : sans elle WPF peint un fond opaque et l'acrylique
         reste invisible (même recette que le flyout et l'OSD). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                            ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Margin="12">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlide"/>
        </Grid.RenderTransform>
        <local:AirPodsView x:Name="View"/>
    </Grid>
</Window>
