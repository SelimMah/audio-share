<Window x:Class="AudioShare.AirPodsPopup" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Duckast" Width="336" Height="92"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <!-- Fenêtre AirPods de la charte (design/maquettes/04-fenetre-airpods.html) :
         336 × 92, acrylique permanent (WindowEffects.ApplyPopup), toute la
         fenêtre est cliquable pour l'action principale. Le contenu (teintes
         d'état, boîtier au trait, statut, niveaux) est construit en code. -->

    <!-- Vitre étendue : sans elle WPF peint un fond opaque et l'acrylique
         reste invisible (même recette que le flyout et l'OSD). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1"
                            ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="#00FFFFFF" ClipToBounds="True" RenderTransformOrigin="0.5,1"/>
</Window>
